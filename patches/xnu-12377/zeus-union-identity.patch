+/*
+ * The volume seen at "/". The owner chain union-mounts the SystemOS volume over the root volume's "/", so files
+ * there come from two APFS volumes with two device ids, and getfsstat lists two mounts on "/". Apple CoreServices
+ * (LaunchServices / FileIDTree / _MountInfoPrepare) identifies a volume by its device id and aborts on a second volume with the same one or on a device id
+ * no mount lists. As macOS-DroidVM's virt_union_top and UniXNU macOS profile do, the root volume under the union is reported as the union:
+ * getfsstat leaves the root volume out and stat, statfs and getattrlist give the SystemOS volume's device id and statfs,
+ * which keeps MNT_UNION, so libc's opendir reads a directory of both layers whole and drops the duplicate names.
+ */
+mount_t
+native_union_identity(mount_t mp)
+{
+	mount_t top = rootvnode != NULLVP ? rootvnode->v_mount : NULL;
+	if (mp != NULL && top != NULL && top != mp && (top->mnt_flag & MNT_UNION) && top->mnt_vnodecovered != NULLVP &&
+	    top->mnt_vnodecovered->v_mount == mp && (mp->mnt_flag & MNT_ROOTFS)) {
+		return top;
+	}
+	return mp;
+}
