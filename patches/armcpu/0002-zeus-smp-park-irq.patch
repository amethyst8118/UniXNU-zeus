 // IPI and handler setup, before it is marked running. The core never joins the scheduler; processor_start stalls only its helper.
 static unsigned gSmpPark = 0;
+// 3, 4 and 5 let the core run and join the scheduler with one interrupt source taken away: 3 no timer PPI 27 (IPIs work), 4 no IPI
+// (timer works), 5 no interrupts at all (Group 1 off after the setup).
 volatile uint32_t armcpu_irq_phase = 0,armcpu_irq_id = 1023;
 // IRQ drains (ArmCpu::interrupt takes interrupts until none is pending) that took more than 128, and the most one took. A burst
