zeus diagnostic (temporary): name the libkern factory that fails for AMFI.
AMFI panics "failed to create OSDictionary copy: 14" when one of OSArray/OSDictionary/OSData/OSNumber/OSString/OSSymbol
factories returns null while it converts entitlements; the panic screen is the only log on zeus, so the failing
factory panics with its arguments and caller. Also gives zero-capacity OSArray/OSDictionary a backing store.
diff --git a/libkern/c++/OSArray.cpp b/libkern/c++/OSArray.cpp
--- a/libkern/c++/OSArray.cpp
+++ b/libkern/c++/OSArray.cpp
@@ -31,6 +31,7 @@
 
 #define IOKIT_ENABLE_SHARED_PTR
 
+#include <kern/debug.h>
 #include <libkern/c++/OSArray.h>
 #include <libkern/c++/OSDictionary.h>
 #include <libkern/c++/OSLib.h>
@@ -64,6 +65,10 @@
 		return false;
 	}
 
+	/* zeus: a zero capacity still gets a backing store (AMFI builds entitlement containers with 0). */
+	if (inCapacity == 0) {
+		inCapacity = 1;
+	}
 	array = kallocp_type_container(ArrayPtrType, &inCapacity, Z_WAITOK_ZERO);
 	if (!array) {
 		return false;
@@ -127,6 +132,7 @@
 	OSSharedPtr<OSArray> me = OSMakeShared<OSArray>();
 
 	if (me && !me->initWithCapacity(capacity)) {
+		panic("zeus-os: OSArray::withCapacity(%u) failed from %p", capacity, __builtin_ptrauth_strip(__builtin_return_address(0), 0));
 		return nullptr;
 	}
 
