+bool NativeAdrenoVm::mappingBelow(uint64_t iova,uint64_t *base,uint64_t *bytes,uint64_t *handle) const
+{
+    if(!base || !bytes || !handle || !attached_ || !mappings_)return false;
+    const Mapping *best=nullptr;
+    for(size_t i=0;i<high_;++i) {
+        const Mapping &m=mappings_[i];
+        if(m.memory && m.iova<=iova && (!best || m.iova>best->iova))best=&m;
+    }
+    if(!best)return false;
+    *base=best->iova;*bytes=best->memory->bytes();*handle=best->handle;return true;
+}
+IOReturn NativeAdrenoVm::contextTtbr0(uint64_t *out) const
+{
+    if(!out || !attached_)return kIOReturnBadArgument;
+    uint64_t offset=0;
+    for(const auto &region:regions_)if(region.state && region.state->context_offset)offset=region.state->context_offset;
+    if(!offset)return kIOReturnNotReady;
+    uint32_t lo=0,hi=0;
+    if(io_.read32(io_.cookie,(size_t)offset+0x20,&lo) || io_.read32(io_.cookie,(size_t)offset+0x24,&hi))return kIOReturnIOError;
+    *out=(uint64_t)hi<<32|lo;return kIOReturnSuccess;
+}
