+
+/*
+ * zeus bring-up: when initproc dies, put the faulting user state and the
+ * kernel log tail on the panic screen (no log survives a reset on zeus).
+ */
+#include <mach/arm/thread_status.h>
+extern struct arm_saved_state *find_user_regs(thread_t);
+extern const char *zeus_log_tail(void);
+static char zeus_init_crash[1024];
+
+static const char *
+zeus_initproc_crash_state(void)
+{
+	thread_t self = current_thread();
+	struct uthread *ut = get_bsdthread_info(self);
+	struct arm_saved_state *ss = find_user_regs(self);
+	uint32_t insn[4] = {0, 0, 0, 0};
+	if (ss == NULL || ut == NULL) {
+		strlcpy(zeus_init_crash, "no user state", sizeof(zeus_init_crash));
+		return zeus_init_crash;
+	}
+	unsigned long long pc = (unsigned long long)get_saved_state_pc(ss);
+	int mapped = copyin((user_addr_t)((pc & ~3ULL) - 8), insn, sizeof(insn)) == 0;
+	snprintf(zeus_init_crash, sizeof(zeus_init_crash),
+	    "exc=%d code=0x%llx sub=0x%llx\npc=0x%llx lr=0x%llx sp=0x%llx\nfar=0x%llx esr=0x%llx cpsr=0x%x\n"
+	    "x0=0x%llx x1=0x%llx x2=0x%llx x3=0x%llx\nx8=0x%llx x16=0x%llx x17=0x%llx fp=0x%llx\n"
+	    "insn(pc-8)=%08x %08x [%08x] %08x %s",
+	    ut->uu_exception, (unsigned long long)ut->uu_code, (unsigned long long)ut->uu_subcode,
+	    pc, (unsigned long long)get_saved_state_lr(ss), (unsigned long long)get_saved_state_sp(ss),
+	    (unsigned long long)get_saved_state_far(ss), (unsigned long long)get_saved_state_esr(ss),
+	    (unsigned)get_saved_state_cpsr(ss),
+	    (unsigned long long)get_saved_state_reg(ss, 0), (unsigned long long)get_saved_state_reg(ss, 1),
+	    (unsigned long long)get_saved_state_reg(ss, 2), (unsigned long long)get_saved_state_reg(ss, 3),
+	    (unsigned long long)get_saved_state_reg(ss, 8), (unsigned long long)get_saved_state_reg(ss, 16),
+	    (unsigned long long)get_saved_state_reg(ss, 17), (unsigned long long)get_saved_state_reg(ss, 29),
+	    insn[0], insn[1], insn[2], insn[3], mapped ? "" : "(pc unmapped)");
+	{
+		/* Shared cache slide and the user frame-pointer chain (return addresses, PAC stripped). */
+		struct user64_dyld_all_image_infos infos = {};
+		size_t n = strlen(zeus_init_crash);
+		unsigned long long fp = (unsigned long long)get_saved_state_reg(ss, 29);
+		user_addr_t infos_addr = (user_addr_t)task_get_all_image_info_addr(current_task());
+		if (infos_addr) {
+			(void)copyin(infos_addr, &infos, sizeof(infos));
+		}
+		n += (size_t)snprintf(zeus_init_crash + n, sizeof(zeus_init_crash) - n, "\nslide=0x%llx bt",
+		    (unsigned long long)infos.sharedCacheSlide);
+		for (int i = 0; i < 18 && fp != 0 && (fp & 7) == 0 && n + 20 < sizeof(zeus_init_crash); i++) {
+			unsigned long long fr[2] = {0, 0};
+			if (copyin((user_addr_t)fp, fr, sizeof(fr)) != 0) {
+				break;
+			}
+			n += (size_t)snprintf(zeus_init_crash + n, sizeof(zeus_init_crash) - n, " %llx",
+			    fr[1] & 0x00007fffffffffffULL);
+			if (fr[0] <= fp) {
+				break;
+			}
+			fp = fr[0];
+		}
+	}
+	return zeus_init_crash;
 }
 
