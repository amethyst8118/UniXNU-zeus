 extern "C" uint64_t thread_tid (thread_t);
+extern "C" processor_t cpu_to_processor (int);
+extern "C" processor_t thread_bind (processor_t);
+extern "C" wait_result_t thread_block (thread_continue_t);
+// zeus bisect, boot-arg armcpu-smp-bound=N: a kernel thread bound to logical core 1 (with armcpu-smp-recommend=1 the only thread
+// besides its idle thread). 1: a compute loop and IOSleep (1); 2: the same plus a 4 MiB memset/memcpy each pass.
+extern "C" { volatile uint64_t armcpu_bound_passes = 0; volatile uint32_t armcpu_bound_cpu = 0xff; }
+static void boundWork (void *argument, wait_result_t)
+{
+  const unsigned mode = static_cast<unsigned> (reinterpret_cast<uintptr_t> (argument));
+  processor_t target = cpu_to_processor (1);
+  if (target == nullptr) { thread_terminate (current_thread ()); return; }
+  thread_bind (target);
+  thread_block (THREAD_CONTINUE_NULL);
+  uint8_t *a = nullptr, *b = nullptr;
+  if (mode == 2) { a = static_cast<uint8_t *> (IOMalloc (4U << 20)); b = static_cast<uint8_t *> (IOMalloc (4U << 20)); }
+  volatile uint64_t sink = 0;
+  for (;;) {
+    for (uint32_t i = 0; i < 200000; i++) { sink = sink + i; }
+    if (a != nullptr && b != nullptr) { memset (a, static_cast<int> (armcpu_bound_passes & 0xff), 4U << 20); memcpy (b, a, 4U << 20); }
+    uint64_t mpidr;
+    __asm__ volatile ("mrs %0, mpidr_el1" : "=r" (mpidr));
+    armcpu_bound_cpu = static_cast<uint32_t> ((mpidr >> 8) & 0xff);
+    armcpu_bound_passes = armcpu_bound_passes + 1;
+    IOSleep (1);
+  }
+}
