+/*
+ * zeus: keep the debug-level unified log of the subsystems that decide SpringBoard's own LaunchServices record. Only default-level
+ * messages are persisted otherwise, and none of them says why -[FBSApplicationLibrary _workQueue_currentProcessProxyWithOutURL:]
+ * finds no valid record for com.apple.springboard inside SpringBoard. The root's /Library/Preferences is a link to
+ * ../private/var/preferences, and the Data store already has preferences/Logging/Subsystems (empty): with boot-arg zeus-logprof=1
+ * one profile per subsystem is written there before launchd starts (logd and every client read them at start-up).
+ * Without it (the board default since gpum63) the same files get stock levels back (Info in memory, Default persisted, no
+ * private data): Data persists, so earlier boots' debug profiles would otherwise stay, and persisted debug logging in
+ * SpringBoard and FrontBoard costs CPU on every frame.
+ * Status: number of profiles written or already the same, or the last error (negative).
+ */
+volatile int zeus_logprof_status = -1;
+static void
+zeus_log_profiles(void)
+{
+	static const char *const subsystems[] = {
+		"com.apple.launchservices", "com.apple.frontboard.ApplicationLibrary", "com.apple.FrontBoard", "com.apple.UserManagement",
+		"com.apple.SpringBoard", "com.apple.installcoordination", "com.apple.containermanager",
+		/* gpum70: icons re-rendered on every home-screen page (IconRendering decoding asset textures, ISIconCache lookups). */
+		"com.apple.iconservices", "com.apple.IconServices", "com.apple.IconRendering",
+	};
+	static const char plist[] =
+	    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	    "<plist version=\"1.0\">\n<dict>\n"
+	    "\t<key>DEFAULT-OPTIONS</key>\n\t<dict>\n"
+	    "\t\t<key>Enable-Private-Data</key>\n\t\t<true/>\n"
+	    "\t\t<key>Level</key>\n\t\t<dict>\n"
+	    "\t\t\t<key>Enable</key>\n\t\t\t<string>Debug</string>\n"
+	    "\t\t\t<key>Persist</key>\n\t\t\t<string>Debug</string>\n"
+	    "\t\t</dict>\n\t</dict>\n"
+	    "</dict>\n</plist>\n";
+	static const char stock[] =
+	    "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	    "<plist version=\"1.0\">\n<dict>\n"
+	    "\t<key>DEFAULT-OPTIONS</key>\n\t<dict>\n"
+	    "\t\t<key>Level</key>\n\t\t<dict>\n"
+	    "\t\t\t<key>Enable</key>\n\t\t\t<string>Info</string>\n"
+	    "\t\t\t<key>Persist</key>\n\t\t\t<string>Default</string>\n"
+	    "\t\t</dict>\n\t</dict>\n"
+	    "</dict>\n</plist>\n";
+	uint32_t enabled = 0;
+	const int debug = PE_parse_boot_argn("zeus-logprof", &enabled, sizeof(enabled)) && enabled == 1;
+	const char *body = debug ? plist : stock;
+	const size_t body_size = debug ? sizeof(plist) - 1 : sizeof(stock) - 1;
+	vfs_context_t ctx = vfs_context_current();
+	char path[160];
+	int done = 0, last = 0;
+	for (size_t i = 0; i < sizeof(subsystems) / sizeof(subsystems[0]); ++i) {
+		snprintf(path, sizeof(path), "/private/var/preferences/Logging/Subsystems/%s.plist", subsystems[i]);
+		int error = native_gpu_addon_write(path, (const uint8_t *)body, body_size, 0644, ctx);
+		if (error == 0 || error == -1) {
+			done++;
+		} else {
+			last = error;
+		}
+	}
+	zeus_logprof_status = last ? -last : done;
+	printf("zeus-logprof: %s log profiles %d (count written or same, negative = last error)\n", debug ? "debug" : "stock",
+	    zeus_logprof_status);
+}
