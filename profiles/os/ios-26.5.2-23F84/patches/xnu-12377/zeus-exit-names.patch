+/*
+ * zeus (profiles/os/ios-26.5.2-23F84/patches/xnu-12377/zeus-exit-names.patch): print how selected processes end, to the
+ * boot log. Boot-arg exit-name=a,b,c (p_comm names, max 127 chars); default = the daemons that respawn during migration.
+ */
+static bool
+zeus_exit_name_match(const char *comm)
+{
+	static char names[128];
+	static int loaded;
+	if (!loaded) {
+		if (!PE_parse_boot_argn("exit-name", names, sizeof(names))) {
+			strlcpy(names, "fairplayd.H2,seputil,aonsensed,com.apple.datami,datamigrator", sizeof(names));
+		}
+		loaded = 1;
+	}
+	size_t len = strnlen(comm, MAXCOMLEN + 1);
+	const char *c = names;
+	while (*c) {
+		const char *e = c;
+		while (*e && *e != ',') {
+			e++;
+		}
+		if ((size_t)(e - c) == len && strncmp(c, comm, len) == 0) {
+			return true;
+		}
+		c = *e ? e + 1 : e;
+	}
+	return false;
 }
 
