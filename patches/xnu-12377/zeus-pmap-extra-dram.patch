@@ -6092,7 +6166,7 @@ wimg_to_pte(unsigned int wimg, pmap_paddr_t pa)
 		break;
 	case VM_WIMG_WCOMB:
 		/* DRAM outside the gDramBase window (more than one physical range) is still managed memory: Normal, not Device. */
-		if (is_dram_addr(pa) || pa_valid(pa)) {
+		if (pmap_is_dram(pa) || pa_valid(pa)) {
 			pte = ARM_PTE_ATTRINDX(CACHE_ATTRINDX_WRITECOMB);
 		} else {
 #if HAS_FEAT_XS
@@ -10682,6 +10756,9 @@ pmap_cache_attributes(
 
 	if (!pa_valid(paddr)) {
 		pmap_io_range_t *io_rgn = pmap_find_io_attr(paddr);
+		if (io_rgn == NULL && zeus_extra_dram_addr(paddr)) {
