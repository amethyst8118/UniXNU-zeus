diff --git a/ZeusClientQuirks.h b/ZeusClientQuirks.h
new file mode 100644
index 0000000..741d3aa
--- /dev/null
+++ b/ZeusClientQuirks.h
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: MIT
+// zeus (Xiaomi 12 Pro, A730, iOS 26.5.2 23F84): client cache directory, shipped system cache, UIKit display-link rate.
+// UniXNU-zeus patches/adrenometal/0005.
+#pragma once
+#include <CoreFoundation/CoreFoundation.h>
+#include <errno.h>
+#include <objc/runtime.h>
+#include <os/log.h>
+#include <pwd.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/sysctl.h>
+#include <unistd.h>
+
+extern "C" int sandbox_check(pid_t pid, const char *operation, int type, ...);
+extern "C" bool native_bridge_metal_system_cache(const char *reader, const uint32_t *owners, unsigned count, bool writer);
+
+namespace zeusdl {
+static bool bootArg(const char *token) {
+    char args[1100] = {};
+    size_t size = sizeof args - 1;
+    if (sysctlbyname("kern.bootargs", args, &size, nullptr, 0) != 0) return false;
+    const size_t n = strlen(token);
+    for (const char *at = strstr(args, token); at; at = strstr(at + 1, token))
+        if ((at == args || at[-1] == ' ') && (at[n] == 0 || at[n] == ' ')) return true;
+    return false;
+}
+}  // namespace zeusdl
+
+// A directory this process may keep: made level by level, owned by this user, writable. 0 or the step that failed (x100) + errno.
+static int zeusUsableDirectory(const char *const *levels, unsigned count) {
+    for (unsigned i = 0; i < count; ++i)
+        if (mkdir(levels[i], 0700) != 0 && errno != EEXIST) return 100 * (i + 1) + errno;
+    struct stat st = {};
+    const char *path = levels[count - 1];
+    if (lstat(path, &st) != 0) return 900 + errno;
+    if (!S_ISDIR(st.st_mode) || st.st_uid != getuid()) return 950;
+    if (access(path, W_OK) != 0) return 980 + errno;
+    return 0;
+}
+
+// A persistent cache directory for a client, or "": <Caches>/<bundle id>/com.apple.metalfe/m2v (Metal's own iOS cache directory),
+// then <Caches>/<bundle id>/m2v. <Caches> is $HOME/Library/Caches ($HOME is a containerised app's container).
+static void zeusPersistentClientCache(char *out, size_t size) {
+    out[0] = 0;
+    const char *home = getenv("HOME");
+    if (!home || !home[0]) {
+        if (const passwd *user = getpwuid(getuid()); user && user->pw_dir) home = user->pw_dir;
+    }
+    char name[256] = {};
+    if (CFBundleRef bundle = CFBundleGetMainBundle()) {
+        if (CFStringRef ident = CFBundleGetIdentifier(bundle)) CFStringGetCString(ident, name, sizeof name, kCFStringEncodingUTF8);
+    }
+    if (!name[0]) strlcpy(name, getprogname(), sizeof name);
+    for (char *c = name; *c; ++c) if (*c == '/') *c = '_';
+    int why[2] = {-1, -1};
+    if (home && home[0] && strcmp(home, "/") && strcmp(home, "/var/empty")) {
+        char caches[512], app[512], metalfe[512], a[512], b[512];
+        snprintf(caches, sizeof caches, "%s/Library/Caches", home);
+        snprintf(app, sizeof app, "%s/%s", caches, name);
+        snprintf(metalfe, sizeof metalfe, "%s/com.apple.metalfe", app);
+        snprintf(a, sizeof a, "%s/m2v", metalfe);
+        snprintf(b, sizeof b, "%s/m2v", app);
+        const char *first[] = {caches, app, metalfe, a}, *second[] = {caches, app, b};
+        const bool sandboxed = sandbox_check(getpid(), nullptr, 0) == 1;
+        // SANDBOX_FILTER_PATH (1) | SANDBOX_CHECK_NO_REPORT (0x40000000): nonzero refuses; a refused probe writes no report.
+        for (int k = 0; k < 2 && !out[0]; ++k) {
+            const char *path = k ? b : a;
+            if (sandboxed && sandbox_check(getpid(), "file-write-create", 1 | 0x40000000, path) != 0) {why[k] = 1; continue;}
+            why[k] = k ? zeusUsableDirectory(second, 3) : zeusUsableDirectory(first, 4);
+            if (!why[k] && strlen(path) + 1 <= size) strlcpy(out, path, size);
+        }
+    }
+    os_log(OS_LOG_DEFAULT, "NativeAdrenoMetal zeus: client cache %{public}s (%{public}s; home %{public}s; metalfe %d, app %d)",
+           out[0] ? out : "none", name, home ? home : "-", why[0], why[1]);
+}
+
+// The read-only system cache shipped in the image (the union of a boot's caches for this plug-in build). True when it is the layer.
+static const char kZeusSystemLayer[] = "/System/Library/Extensions/NativeAdrenoMetal.cache";
+static bool zeusSystemLayer() {
+    if (zeusdl::bootArg("zeus-syscache=0")) return false;
+    struct stat st = {};
+    if (lstat(kZeusSystemLayer, &st) != 0 || !S_ISDIR(st.st_mode)) return false;
+    static const uint32_t owners[] = {0};
+    return native_bridge_metal_system_cache(kZeusSystemLayer, owners, 1, false);
+}
+
+// UIKit's in-process animation manager asks its CADisplayLink for 20..120 a second, preferred 30. zeus-dl=0 turns the drop off.
+namespace zeusdl {
+typedef struct {float minimum, maximum, preferred;} Range;
+static id (*made)(id, SEL, id, SEL);
+static void (*fps)(id, SEL, long);
+static void (*range)(id, SEL, Range);
+static char key;
+static unsigned marked, dropped;
+static bool full(id link) {return objc_getAssociatedObject(link, &key) != nil;}
+static id linkWith(id self, SEL sel, id target, SEL action) {
+    id link = made(self, sel, target, action);
+    if (link && target && strstr(object_getClassName(target), "InProcessAnimationManager")) {
+        objc_setAssociatedObject(link, &key, (__bridge id)kCFBooleanTrue, OBJC_ASSOCIATION_ASSIGN);
+        if (marked++ < 2) os_log(OS_LOG_DEFAULT, "NativeAdrenoMetal zeus: display link of %{public}s follows the display", object_getClassName(target));
+    }
+    return link;
+}
+static void setFps(id self, SEL sel, long value) {
+    if (full(self)) {value = 0; ++dropped;}
+    fps(self, sel, value);
+}
+static void setRange(id self, SEL sel, Range value) {
+    const bool animation = value.minimum == 20 && value.maximum == 120 && value.preferred == 30;
+    if (animation || full(self)) {
+        if (dropped++ < 3) os_log(OS_LOG_DEFAULT, "NativeAdrenoMetal zeus: dropped display link rate %.0f..%.0f preferred %.0f (%{public}s)",
+                                  value.minimum, value.maximum, value.preferred, getprogname());
+        value = Range{0, 0, 0};
+    }
+    range(self, sel, value);
+}
+__attribute__((constructor)) static void install() {
+    if (bootArg("zeus-dl=0")) return;
+    Class link = objc_getClass("CADisplayLink");
+    if (!link) return;
+    Method m = class_getClassMethod(link, sel_registerName("displayLinkWithTarget:selector:"));
+    Method f = class_getInstanceMethod(link, sel_registerName("setPreferredFramesPerSecond:"));
+    Method r = class_getInstanceMethod(link, sel_registerName("setPreferredFrameRateRange:"));
+    if (!m || !f || !r) return;
+    made = (id (*)(id, SEL, id, SEL))method_setImplementation(m, (IMP)linkWith);
+    fps = (void (*)(id, SEL, long))method_setImplementation(f, (IMP)setFps);
+    range = (void (*)(id, SEL, Range))method_setImplementation(r, (IMP)setRange);
+}
+}  // namespace zeusdl
