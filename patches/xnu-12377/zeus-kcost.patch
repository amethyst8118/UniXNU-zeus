+/*
+ * zeus #kcost: per-call cost counters, read by the board log (package/BootLog.c, the #kcost row). zeus_kcost[kind] = {calls,
+ * mach ticks, the longest call in ticks since the last read (the reader exchanges it with 0), bytes}. Kinds: 0 user faults that
+ * reach vm_fault() (osfmk/arm64/sleh.c handle_user_abort), 1 madvise(), 2 work_interval_ctl(). gpum74: SpringBoard took ~12,000
+ * soft faults a second while swiping and spent a fifth of its main thread's running samples in work_interval_ctl.
+ */
+extern uint64_t mach_absolute_time(void);
+uint64_t zeus_kcost[4][4];
+void zeus_kcost_note(unsigned kind, uint64_t ticks, uint64_t bytes);
+void
+zeus_kcost_note(unsigned kind, uint64_t ticks, uint64_t bytes)
+{
+	if (kind >= 4) {
+		return;
+	}
+	__atomic_fetch_add(&zeus_kcost[kind][0], 1, __ATOMIC_RELAXED);
+	__atomic_fetch_add(&zeus_kcost[kind][1], ticks, __ATOMIC_RELAXED);
+	__atomic_fetch_add(&zeus_kcost[kind][3], bytes, __ATOMIC_RELAXED);
+	uint64_t longest = __atomic_load_n(&zeus_kcost[kind][2], __ATOMIC_RELAXED);
+	while (ticks > longest &&
+	    !__atomic_compare_exchange_n(&zeus_kcost[kind][2], &longest, ticks, 1, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+	}
+}
