+// zeus bisect, boot-arg armcpu-gh-wdt=N: the Gunyah virtual watchdog (SMCCC vendor hypervisor calls 0x86000005 control,
+// 0x86000006 status: x0 result, x1 control state, x2 ms since the last ping) as seen from a secondary core. 1 records the status at
+// initCPU and every 64th interrupt of core 1; 2 also stops it from that core (control 2, as Linux gh_wdt_stop) and records again.
+static unsigned gGhWdt = 0;
+extern "C" { volatile int64_t armcpu_wdt_init[8][3], armcpu_wdt_stop[8][4], armcpu_wdt_live[3]; volatile uint32_t armcpu_wdt_samples = 0; }
+static void ghWdtStatus (volatile int64_t *out)
+{
+  register uint64_t x0 __asm__ ("x0") = 0x86000006ULL;
+  register uint64_t x1 __asm__ ("x1") = 0;
+  register uint64_t x2 __asm__ ("x2") = 0;
+  register uint64_t x3 __asm__ ("x3") = 0;
+  __asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+  out[0] = static_cast<int64_t> (x0); out[1] = static_cast<int64_t> (x1); out[2] = static_cast<int64_t> (x2);
+}
+static int64_t ghWdtControl (uint64_t value)
+{
+  register uint64_t x0 __asm__ ("x0") = 0x86000005ULL;
+  register uint64_t x1 __asm__ ("x1") = value;
+  register uint64_t x2 __asm__ ("x2") = 0;
+  register uint64_t x3 __asm__ ("x3") = 0;
+  __asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : : "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+  return static_cast<int64_t> (x0);
+}
