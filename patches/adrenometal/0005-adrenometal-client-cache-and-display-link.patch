diff --git a/ZeusClientQuirks.h b/ZeusClientQuirks.h
new file mode 100644
index 0000000..1313c3d
--- /dev/null
+++ b/ZeusClientQuirks.h
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: MIT
+// zeus (Xiaomi 12 Pro, A730, iOS 26.5.2 23F84): client cache directory and UIKit display-link rate. patches/adrenometal/0005.
+#pragma once
+#include <CoreFoundation/CoreFoundation.h>
+#include <objc/runtime.h>
+#include <os/log.h>
+#include <pwd.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/sysctl.h>
+#include <unistd.h>
+
+extern "C" int sandbox_check(pid_t pid, const char *operation, int type, ...);
+
+// A persistent cache directory for a client: $HOME/Library/Caches/<bundle id or process name>/m2v, or "" when the sandbox refuses it.
+static void zeusPersistentClientCache(char *out, size_t size) {
+    out[0] = 0;
+    const char *home = getenv("HOME");
+    if (!home || !home[0]) {
+        if (const passwd *user = getpwuid(getuid()); user && user->pw_dir) home = user->pw_dir;
+    }
+    if (!home || !home[0] || !strcmp(home, "/") || !strcmp(home, "/var/empty")) return;
+    char name[256] = {};
+    if (CFBundleRef bundle = CFBundleGetMainBundle()) {
+        if (CFStringRef ident = CFBundleGetIdentifier(bundle)) CFStringGetCString(ident, name, sizeof name, kCFStringEncodingUTF8);
+    }
+    if (!name[0]) strlcpy(name, getprogname(), sizeof name);
+    for (char *c = name; *c; ++c) if (*c == '/') *c = '_';
+    char caches[512], dir[512], path[512];
+    snprintf(caches, sizeof caches, "%s/Library/Caches", home);
+    snprintf(dir, sizeof dir, "%s/%s", caches, name);
+    snprintf(path, sizeof path, "%s/m2v", dir);
+    // SANDBOX_FILTER_PATH (1) | SANDBOX_CHECK_NO_REPORT (0x40000000): nonzero refuses, and a refused probe writes no violation report.
+    if (sandbox_check(getpid(), nullptr, 0) == 1 &&
+        sandbox_check(getpid(), "file-write-create", 1 | 0x40000000, path) != 0) return;
+    mkdir(caches, 0700);
+    mkdir(dir, 0700);
+    mkdir(path, 0700);
+    struct stat st = {};
+    if (lstat(path, &st) || !S_ISDIR(st.st_mode) || st.st_uid != getuid() || access(path, W_OK) != 0) return;
+    if (strlen(path) + 1 > size) return;
+    strlcpy(out, path, size);
+}
+
+// UIKit's in-process animation manager asks its CADisplayLink for 20..120 a second, preferred 30. Its rate requests are dropped for
+// that link only (the link then follows the display), as UniXNU-zizhan does (57 -> 95 fps). zeus-dl=0 turns it off.
+namespace zeusdl {
+typedef struct {float minimum, maximum, preferred;} Range;
+static id (*made)(id, SEL, id, SEL);
+static void (*fps)(id, SEL, long);
+static void (*range)(id, SEL, Range);
+static char key;
+static unsigned marked, dropped;
+static bool full(id link) {return objc_getAssociatedObject(link, &key) != nil;}
+static id linkWith(id self, SEL sel, id target, SEL action) {
+    id link = made(self, sel, target, action);
+    if (link && target && strstr(object_getClassName(target), "InProcessAnimationManager")) {
+        objc_setAssociatedObject(link, &key, (__bridge id)kCFBooleanTrue, OBJC_ASSOCIATION_ASSIGN);
+        if (marked++ < 2) os_log(OS_LOG_DEFAULT, "NativeAdrenoMetal zeus: display link of %{public}s follows the display", object_getClassName(target));
+    }
+    return link;
+}
+static void setFps(id self, SEL sel, long value) {
+    if (full(self)) {value = 0; ++dropped;}
+    fps(self, sel, value);
+}
+static void setRange(id self, SEL sel, Range value) {
+    if (full(self)) {
+        if (dropped++ < 2) os_log(OS_LOG_DEFAULT, "NativeAdrenoMetal zeus: dropped display link rate %.0f..%.0f preferred %.0f", value.minimum, value.maximum, value.preferred);
+        value = Range{0, 0, 0};
+    }
+    range(self, sel, value);
+}
+static bool bootArg(const char *token) {
+    char args[1100] = {};
+    size_t size = sizeof args - 1;
+    if (sysctlbyname("kern.bootargs", args, &size, nullptr, 0) != 0) return false;
+    const size_t n = strlen(token);
+    for (const char *at = strstr(args, token); at; at = strstr(at + 1, token))
+        if ((at == args || at[-1] == ' ') && (at[n] == 0 || at[n] == ' ')) return true;
+    return false;
+}
+__attribute__((constructor)) static void install() {
+    if (bootArg("zeus-dl=0")) return;
+    Class link = objc_getClass("CADisplayLink");
+    if (!link) return;
+    Method m = class_getClassMethod(link, sel_registerName("displayLinkWithTarget:selector:"));
+    Method f = class_getInstanceMethod(link, sel_registerName("setPreferredFramesPerSecond:"));
+    Method r = class_getInstanceMethod(link, sel_registerName("setPreferredFrameRateRange:"));
+    if (!m || !f || !r) return;
+    made = (id (*)(id, SEL, id, SEL))method_setImplementation(m, (IMP)linkWith);
+    fps = (void (*)(id, SEL, long))method_setImplementation(f, (IMP)setFps);
+    range = (void (*)(id, SEL, Range))method_setImplementation(r, (IMP)setRange);
+}
+}  // namespace zeusdl
