+/*
+ * zeus (patches/xnu-12377/zeus-pmap-extra-dram.patch): DRAM outside the gDramBase window that a board driver owns (the GPU memory
+ * pool: the high-bank runs DarwinBoot lists in /chosen/darwinboot-memory-outside). Those pages are not managed (pa_valid is false)
+ * and is_dram_addr() calls them "not DRAM", so every CPU mapping of them was Device memory: VM_WIMG_WCOMB/RT fell back to
+ * Device-GRE in wimg_to_pte and pmap_cache_attributes answered VM_WIMG_IO for default mappings (PAR_EL1 attribute 0x0c in
+ * boot-pool3; DC ZVA in bzero and user-space memset faulted, backboardd crashed). A range added here is DRAM for this pmap:
+ * write-combined and real-time mappings become Normal Non-cacheable, default mappings Normal write-back (the GPU is proved
+ * IO-coherent before the pool serves anything). is_dram_addr() itself is unchanged for every other user.
+ * The table only grows; entries are written before the count is published, so readers need no lock.
+ */
+#define ZEUS_EXTRA_DRAM_MAX 8
+static struct {
+	uint64_t base;
+	uint64_t size;
+} zeus_extra_dram[ZEUS_EXTRA_DRAM_MAX];
+static uint32_t zeus_extra_dram_count;
+
+static inline bool
+zeus_extra_dram_addr(uint64_t pa)
+{
+	const uint32_t count = os_atomic_load(&zeus_extra_dram_count, acquire);
+	for (uint32_t i = 0; i < count; ++i) {
+		if (pa - zeus_extra_dram[i].base < zeus_extra_dram[i].size) {
+			return true;
+		}
+	}
+	return false;
+}
+
+#define pmap_is_dram(pa) (is_dram_addr(pa) || zeus_extra_dram_addr((uint64_t)(pa)))
+
+/*
+ * Board entry point: 0 when [base, base + size) is now DRAM for this pmap, else nonzero (unaligned, empty, overlapping XNU's
+ * window or managed memory, overlapping an earlier range, or the table full). Call it before any mapping of the range exists.
+ */
+int zeus_pmap_add_dram(uint64_t base, uint64_t size);
+int
+zeus_pmap_add_dram(uint64_t base, uint64_t size)
+{
+#if XNU_MONITOR
+	(void)base; (void)size;
+	return 1;    /* the table would have to live in PPL data */
+#else
+	if (!size || (base & PAGE_MASK) || (size & PAGE_MASK) || base + size < base) {
+		return 2;
+	}
+	if (base < gDramBase + gDramSize && gDramBase < base + size) {
+		return 3;
+	}
+	for (uint64_t pa = base; pa < base + size; pa += PAGE_SIZE) {
+		if (pa_valid(pa)) {
+			return 4;
+		}
+	}
+	/* One writer: the board's GPU pool probe, once at boot. Readers only see published entries. */
+	int result = 0;
+	const uint32_t count = zeus_extra_dram_count;
+	for (uint32_t i = 0; i < count && !result; ++i) {
+		if (base < zeus_extra_dram[i].base + zeus_extra_dram[i].size && zeus_extra_dram[i].base < base + size) {
+			result = 5;
+		}
+	}
+	if (!result && count >= ZEUS_EXTRA_DRAM_MAX) {
+		result = 6;
+	}
+	if (!result) {
+		zeus_extra_dram[count].base = base;
+		zeus_extra_dram[count].size = size;
+		os_atomic_store(&zeus_extra_dram_count, count + 1, release);
+	}
+	return result;
+#endif /* XNU_MONITOR */
+}
+
