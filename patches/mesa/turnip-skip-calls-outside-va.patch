diff --git a/src/freedreno/vulkan/tu_cs.cc b/src/freedreno/vulkan/tu_cs.cc
index 47e1939..cd2ff0f 100644
--- a/src/freedreno/vulkan/tu_cs.cc
+++ b/src/freedreno/vulkan/tu_cs.cc
@@ -8,6 +8,24 @@
 #include "tu_device.h"
 #include "tu_rmv.h"
 #include "tu_suballoc.h"
+#include "util/log.h"
+#include "util/u_atomic.h"
+#include <inttypes.h>
+
+/* zeus: see tu_cs_iova_ok in tu_cs.h. Calls and states refused, process-wide; the first 16 are logged. */
+uint64_t tu_cs_bad_iova;
+
+bool
+tu_cs_iova_ok(const struct tu_cs *cs, uint64_t iova, uint64_t bytes)
+{
+   const struct tu_physical_device *pd = cs->device->physical_device;
+   if (bytes && iova >= pd->va_start && bytes <= pd->va_size && iova - pd->va_start <= pd->va_size - bytes)
+      return true;
+   const uint64_t n = p_atomic_inc_return(&tu_cs_bad_iova);
+   if (n <= 16)
+      mesa_logw("tu: GPU address 0x%" PRIx64 " + 0x%" PRIx64 " outside the client range, skipped (%" PRIu64 ")", iova, bytes, n);
+   return false;
+}
 
