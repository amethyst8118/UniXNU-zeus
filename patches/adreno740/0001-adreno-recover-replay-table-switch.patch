+/* The table switch of a recovery replay. Mode 1 (the CPU writes TTBR0) cannot use useVm there: waitAll would wait for the jobs after
+ * the hung one, which are still active but not issued again on the restarted ring, and Submit::wait finds no ring for their fences
+ * (kIOReturnBadArgument; zeus 2026-11-19: recover stopped at step 5 and the GPU stayed poisoned). Every job replayed so far is on ring 0,
+ * so the switch waits for that ring to drain, as useVm's waitAll would outside a replay. Mode 0 and 2 are useVm unchanged. */
+IOReturn NativeAdrenoSubmit::useVmReplay(NativeAdrenoVm *vm,const NativeAdrenoRingClock *clock)
+{
+    if(table_mode_!=1)return useVm(vm,clock);
+    if(vm==table_vm_)return kIOReturnSuccess;
+    if(!clock)return kIOReturnBadArgument;
+    IOReturn status=ring(0)->idle(clock,2000000);
+    if(status)return status;
+    status=write_table_(table_cookie_,vm->ttbr0());
+    if(status)return poison();
+    native_adreno_table_switches[1]=native_adreno_table_switches[1]+1;
+    table_vm_=vm;return kIOReturnSuccess;
+}
 IOReturn NativeAdrenoSubmit::forgetVm(NativeAdrenoVm *vm,const NativeAdrenoRingClock *clock,uint32_t timeout_us)
