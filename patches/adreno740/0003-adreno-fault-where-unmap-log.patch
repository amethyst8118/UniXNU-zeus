+/* zeus (patches/adreno740/0003): where a GPU translation fault's address lies, at the four newest snapshots that found a fault
+ * (native_adreno_fault_where_count & 3 is the next slot). [0] FAR; [1] the context bank's TTBR0 now, [2] the job VM's TTBR0, [3] that
+ * of the VM the submit path last switched the bank to (table mode 1); [4] the job VM's live handle at FAR (0: none); [5..7] the job
+ * VM's nearest mapping at or below FAR: base, bytes, handle; [8] entries of the unmap log (the last 256 unmaps, every VM) over FAR;
+ * [9..12] the newest such entry: address, bytes, handle | ASID << 48, time (us, VM clock); [13] the snapshot's time (VM clock);
+ * [14] the job's submission time (ring clock); [15] unmaps logged since boot. */
+extern "C" {volatile uint64_t native_adreno_fault_where[4][16];volatile uint32_t native_adreno_fault_where_count;
+    extern volatile uint64_t native_adreno_unmap_log[256][4];extern volatile uint32_t native_adreno_unmap_log_count;
+    extern uint64_t (*native_adreno_vm_now_us)(void);}
+static void noteFaultWhere(const NativeAdrenoVm *bank,const NativeAdrenoVm *space,const NativeAdrenoVm *table,uint64_t submit_us,
+    const uint32_t fault[4])
+{
+    const uint64_t far=(uint64_t)fault[2]<<32|fault[1];
+    uint64_t out[16]={};
+    out[0]=far;(void)bank->contextTtbr0(&out[1]);out[2]=space->ttbr0();out[3]=table?table->ttbr0():0;
+    out[4]=space->handleAt(far);
+    (void)space->mappingBelow(far,&out[5],&out[6],&out[7]);
+    const uint32_t logged=native_adreno_unmap_log_count,first=logged>256?logged-256:0;
+    for(uint32_t n=logged;n>first;--n) {
+        const volatile uint64_t *entry=native_adreno_unmap_log[(n-1)&255];
+        if(far<entry[0] || far-entry[0]>=entry[1])continue;
+        if(!out[8]) {out[9]=entry[0];out[10]=entry[1];out[11]=entry[2];out[12]=entry[3];}
+        ++out[8];
+    }
+    out[13]=native_adreno_vm_now_us?native_adreno_vm_now_us():0;out[14]=submit_us;out[15]=logged;
+    const uint32_t k=native_adreno_fault_where_count;
+    for(unsigned i=0;i<16;++i)native_adreno_fault_where[k&3][i]=out[i];
+    native_adreno_fault_where_count=k+1;
+}
