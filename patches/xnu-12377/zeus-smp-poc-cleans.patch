+#if !defined(APPLE_ARM64_ARCH_FAMILY)
+		{
+			/* zeus (from iOSPlus10 patches/xnu-12377/0003, MIT, akshaynexus/iOSPlus10): the reset stub reads these through
+			 * physical addresses with caches off. flush_dcache() may do nothing on a coherent-I/O build, so clean every range to
+			 * the point of coherency by VA, and add the whole cpu data table and the bootstrap page tables the reset path walks.
+			 * Without it a secondary started by PSCI CPU_ON faults with the MMU off and Gunyah powers the phone off. */
+			extern boot_args const_boot_args;
+			extern uint8_t bootstrap_pagetables[BOOTSTRAP_TABLE_SIZE];
+			CleanPoC_DcacheRegion_Force((vm_offset_t)CpuDataEntries, sizeof(CpuDataEntries));
+			CleanPoC_DcacheRegion_Force((vm_offset_t)cpu_data_ptr, sizeof(cpu_data_t));
+			CleanPoC_DcacheRegion_Force((vm_offset_t)&ResetHandlerData, sizeof(ResetHandlerData));
+			CleanPoC_DcacheRegion_Force((vm_offset_t)&const_boot_args, sizeof(const_boot_args));
+			CleanPoC_DcacheRegion_Force((vm_offset_t)&cpu_ttep, sizeof(cpu_ttep));
+			CleanPoC_DcacheRegion_Force((vm_offset_t)bootstrap_pagetables, BOOTSTRAP_TABLE_SIZE);
+			__builtin_arm_dsb(DSB_SY);
+		}
+#endif
